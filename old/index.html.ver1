<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>ポケモン種族値検索</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {

      margin: 0;

      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #e53935,
          #8e0000
        );

      min-height: 100vh;

      padding: 30px 20px;
    }


    .container {

      width: 100%;

      max-width: 1100px;

      margin: auto;
    }


    .header {

      background: white;

      border-radius: 20px;

      padding: 25px;

      box-shadow:
        0 10px 30px
        rgba(0, 0, 0, 0.2);

      margin-bottom: 20px;
    }


    h1 {

      text-align: center;

      margin:
        0 0 25px;
    }


    /* 検索 */

    .search {

      display: flex;

      gap: 10px;
    }


    input {

      flex: 1;

      padding: 14px;

      border:
        2px solid #ddd;

      border-radius: 10px;

      font-size: 17px;

      outline: none;
    }


    input:focus {

      border-color:
        #e53935;
    }


    button {

      border: none;

      border-radius: 10px;

      padding:
        12px 20px;

      font-size: 16px;

      font-weight: bold;

      cursor: pointer;
    }


    .search-button {

      background: #e53935;

      color: white;
    }


    .search-button:hover {

      background: #c62828;
    }


    /* 操作エリア */

    .controls {

      display: flex;

      gap: 10px;

      margin-top: 15px;

      align-items: center;

      flex-wrap: wrap;
    }


    .random-button {

      background: #673ab7;

      color: white;
    }


    .random-button:hover {

      background: #512da8;
    }


    .count-area {

      display: flex;

      align-items: center;

      gap: 8px;

      margin-left: auto;
    }


    select {

      padding: 10px;

      border:
        2px solid #ddd;

      border-radius: 8px;

      font-size: 16px;
    }


    #message {

      text-align: center;

      margin-top: 15px;

      color: #666;
    }


    /* 検索候補 */

    .candidates {

      margin-top: 15px;
    }


    .candidate {

      width: 100%;

      text-align: left;

      background: #f5f5f5;

      color: #222;

      margin-bottom: 8px;

      padding: 12px 15px;
    }


    .candidate:hover {

      background: #eeeeee;
    }


    /* ポケモン一覧 */

    .pokemon-grid {

      display: grid;

      grid-template-columns:
        repeat(
          auto-fill,
          minmax(280px, 1fr)
        );

      gap: 20px;
    }


    /* ポケモンカード */

    .pokemon-card {

      background: white;

      border-radius: 18px;

      padding: 20px;

      box-shadow:
        0 10px 30px
        rgba(0, 0, 0, 0.2);

      animation:
        fadeIn 0.3s ease;
    }


    @keyframes fadeIn {

      from {

        opacity: 0;

        transform:
          translateY(10px);

      }

      to {

        opacity: 1;

        transform:
          translateY(0);

      }

    }


    .pokemon-header {

      text-align: center;
    }


    .pokemon-image {

      width: 140px;

      height: 140px;

      image-rendering: pixelated;
    }


    .pokemon-name {

      font-size: 24px;

      font-weight: bold;

      margin-top: 5px;
    }


    .pokemon-id {

      color: #777;

      font-size: 14px;

      margin-top: 3px;
    }


    /* 種族値 */

    .stats {

      margin-top: 20px;

      display: grid;

      grid-template-columns:
        1fr 1fr;

      gap: 8px;
    }


    .stat {

      background: #f7f7f7;

      padding: 11px;

      border-radius: 8px;

      display: flex;

      justify-content:
        space-between;

      font-size: 14px;
    }


    .total-difference {
      background: #333;
      color: white;
      padding: 15px;
      margin: 20px 0;
      border-radius: 10px;
      text-align: center;
      font-size: 20px;
      font-weight: bold;
    }

    .stat-value {

      font-weight: bold;
    }


    /* 合計 */

    .total {

      margin-top: 15px;

      background:
        linear-gradient(
          135deg,
          #e53935,
          #c62828
        );

      color: white;

      padding: 15px;

      border-radius: 10px;

      text-align: center;
    }


    .total-label {

      font-size: 13px;
    }


    .total-value {

      font-size: 32px;

      font-weight: bold;
    }


    /* スマホ */

    @media (max-width: 600px) {

      body {

        padding: 15px;
      }


      .search {

        flex-direction:
          column;
      }


      .search-button {

        width: 100%;
      }


      .count-area {

        margin-left: 0;

        width: 100%;

        justify-content:
          space-between;
      }


      .pokemon-grid {

        grid-template-columns:
          1fr;
      }

    }

  </style>

</head>


<body>


  <div class="container">


    <div class="header">

      <h1>
        ⚡ ポケモン種族値検索
      </h1>


      <!-- 検索 -->

      <div class="search">

        <input
          id="pokemonName"
          type="text"
          placeholder="例：ピカチュウ、ミュウツー"
          autocomplete="off"
        >

        <button
          class="search-button"
          onclick="searchPokemon()"
        >
          🔍 検索
        </button>

      </div>


      <!-- 操作 -->

      <div class="controls">

        <button
          class="random-button"
          onclick="randomPokemon()"
        >
          🎲 ランダム表示
        </button>


        <div class="count-area">

          <label for="evolutionFilter">
            進化条件
          </label>

          <select id="evolutionFilter">
            <option value="all">すべて</option>
            <option value="final">最終進化</option>
            <option value="none">進化しない</option>
          </select>

        </div>

        <div class="count-area">

          <label for="count">
            表示数
          </label>

          <select id="count">
            
            <option value="1">1匹</option>
            <option value="2">2匹</option>
            <option value="3">3匹</option>
            <option value="4">4匹</option>
            <option value="5" selected>5匹</option>
            <option value="6">6匹</option>
            <option value="7">7匹</option>
            <option value="8">8匹</option>
            <option value="9">9匹</option>
            <option value="10">10匹</option>
            <option value="11">11匹</option>
            <option value="12">12匹</option>
            <option value="13">13匹</option>
            <option value="14">14匹</option>
            <option value="15">15匹</option>
            <option value="16">16匹</option>
            <option value="17">17匹</option>
            <option value="18">18匹</option>
            <option value="19">19匹</option>
            <option value="20">20匹</option>

          </select>

        </div>

      </div>


      <div id="message"></div>


      <div
        id="candidates"
        class="candidates"
      ></div>

    </div>


    <!-- ポケモン表示 -->

    <label>
      <input type="checkbox" id="showTotalDifference">
      合計種族値の差を表示
    </label>
    
    <div id="totalDifference" class="total-difference" style="display: none;">
      合計種族値の差：-
    </div>

    <div
      id="pokemonGrid"
      class="pokemon-grid"
    ></div>


  </div>


  <script>


    // ========================================
    // ポケモン検索
    // ========================================

    async function searchPokemon() {


      const input =
        document.getElementById(
          "pokemonName"
        );


      const keyword =
        input.value.trim();


      const message =
        document.getElementById(
          "message"
        );


      const candidates =
        document.getElementById(
          "candidates"
        );


      const grid =
        document.getElementById(
          "pokemonGrid"
        );


      candidates.innerHTML = "";
      updateTotalDifference();
      grid.innerHTML = "";


      if (!keyword) {

        message.textContent =
          "ポケモン名を入力してください。";

        return;

      }


      message.textContent =
        "検索しています...";


      try {


        const response =
          await fetch(
            `/api/search?name=${encodeURIComponent(keyword)}`
          );


        const data =
          await response.json();


        if (!response.ok) {

          throw new Error(
            data.error
          );

        }


        if (data.length === 0) {

          message.textContent =
            "ポケモンが見つかりませんでした。";

          return;

        }


        message.textContent =
          `${data.length}件見つかりました。`;


        // 1件の場合

        if (data.length === 1) {

          await showPokemon(
            data[0].apiName
          );

          return;

        }


        // 複数候補

        data.forEach(pokemon => {


          const button =
            document.createElement(
              "button"
            );


          button.className =
            "candidate";


          button.textContent =
            pokemon.name;


          button.onclick =
            () => {

              showPokemon(
                pokemon.apiName
              );

            };


          candidates.appendChild(
            button
          );


        });


      } catch (error) {

        message.textContent =
          error.message ||
          "検索に失敗しました。";

      }

    }



    // ========================================
    // ポケモン1匹表示
    // ========================================

    async function showPokemon(
      apiName
    ) {


      const message =
        document.getElementById(
          "message"
        );


      try {


        const response =
          await fetch(
            `/api/pokemon?name=${encodeURIComponent(apiName)}`
          );


        const data =
          await response.json();


        if (!response.ok) {

          throw new Error(
            data.error
          );

        }


        createPokemonCard(
          data
        );


        message.textContent = "";


      } catch (error) {

        message.textContent =
          error.message ||
          "データ取得に失敗しました。";

      }

    }



    // ========================================
    // カード生成
    // ========================================

    function createPokemonCard(
      data
    ) {


      const grid =
        document.getElementById(
          "pokemonGrid"
        );


      const card =
        document.createElement(
          "div"
        );


      card.className =
        "pokemon-card";


      card.innerHTML = `

        <div class="pokemon-header">

          <img
            class="pokemon-image"
            src="${data.image || ""}"
            alt="${data.name}"
          >

          <div class="pokemon-name">
            ${data.name}
          </div>

          <div class="pokemon-id">
            No.${String(data.id).padStart(4, "0")}
          </div>

        </div>


        <div class="stats">

          <div class="stat">
            <span>HP</span>
            <span class="stat-value">
              ${data.hp}
            </span>
          </div>

          <div class="stat">
            <span>こうげき</span>
            <span class="stat-value">
              ${data.attack}
            </span>
          </div>

          <div class="stat">
            <span>ぼうぎょ</span>
            <span class="stat-value">
              ${data.defense}
            </span>
          </div>

          <div class="stat">
            <span>とくこう</span>
            <span class="stat-value">
              ${data.specialAttack}
            </span>
          </div>

          <div class="stat">
            <span>とくぼう</span>
            <span class="stat-value">
              ${data.specialDefense}
            </span>
          </div>

          <div class="stat">
            <span>すばやさ</span>
            <span class="stat-value">
              ${data.speed}
            </span>
          </div>

        </div>


        <div class="total">

          <div class="total-label">
            種族値合計
          </div>

          <div class="total-value">
            ${data.total}
          </div>

        </div>

      `;


      grid.appendChild(
        card
      );

      updateTotalDifference();

    }

    // 合計種族値の差を計算
    function updateTotalDifference() {
      const grid = document.getElementById("pokemonGrid");

      const totals = [...grid.querySelectorAll(".total-value")]
        .map(el => Number(el.textContent.trim()))
        .filter(Number.isFinite)
        .map(total => Math.round(total / 10) * 10);

      const display = document.getElementById("totalDifference");

      if (totals.length === 0) {
        display.textContent = "合計種族値の差：-";
        return;
      }

      const maxTotal = Math.max(...totals);
      const minTotal = Math.min(...totals);

      display.textContent =
        `合計種族値の差：${maxTotal - minTotal}`;
    }

        
    // チェックボックスで合計種族値の差を表示・非表示
    document.getElementById("showTotalDifference").addEventListener("change", function () {
      const display = document.getElementById("totalDifference");

      display.style.display = this.checked ? "block" : "none";
    });

    // ========================================
    // ランダムポケモン
    // ========================================

    async function randomPokemon() {
      const count = Number(
        document.getElementById("count").value
      );

      const message = document.getElementById("message");
      const grid = document.getElementById("pokemonGrid");
      const candidates = document.getElementById("candidates");

      const evolution =
        document.getElementById("evolutionFilter")?.value || "all";

      grid.innerHTML = "";
      updateTotalDifference();
      candidates.innerHTML = "";

      message.textContent = `${count}匹選んでいます...`;

      // 重複表示を防ぐ
      const seen = new Set();

      // 追加取得を含めて最大10回試行
      let attempts = 0;
      const maxAttempts = 10;

      try {
        while (
          grid.children.length < count &&
          attempts < maxAttempts
        ) {
          attempts++;

          const remaining = count - grid.children.length;

          message.textContent =
            `${count}匹中${grid.children.length}匹を表示済み。追加取得中...`;

          const params = new URLSearchParams({
            count: String(remaining),
            evolution: evolution
          });

          const response = await fetch(
            `/api/random?${params.toString()}`
          );

          const data = await response.json();

          if (!response.ok) {
            throw new Error(
              data.error || "ランダム取得に失敗しました。"
            );
          }

          if (!Array.isArray(data) || data.length === 0) {
            break;
          }

          let addedThisRound = false;

          for (const pokemon of data) {
            if (grid.children.length >= count) {
              break;
            }

            // 同じポケモンを重複表示しない
            if (seen.has(pokemon.apiName)) {
              continue;
            }

            seen.add(pokemon.apiName);

            const before = grid.children.length;

            // showPokemon 内で取得に失敗しても次へ進む
            await showPokemon(pokemon.apiName);

            if (grid.children.length > before) {
              addedThisRound = true;
            }
          }

          // 追加できなかった場合も、次の試行で補充を試みる
          if (!addedThisRound && data.length === 0) {
            break;
          }
        }

        const displayed = grid.children.length;

        if (displayed === count) {
          message.textContent =
            `${displayed}匹のポケモンを表示しました。`;
        } else {
          message.textContent =
            `${count}匹中${displayed}匹を表示しました。取得できないポケモンがあるため、補充を終了しました。`;
        }
      } catch (error) {
        const displayed = grid.children.length;

        message.textContent =
          `${displayed}匹表示しました。` +
          (error.message || "追加取得に失敗しました。");
      }
    }




    // Enterキー

    document
      .getElementById(
        "pokemonName"
      )
      .addEventListener(
        "keydown",
        event => {

          if (
            event.key === "Enter"
          ) {

            searchPokemon();

          }

        }
      );


  </script>

</body>

</html>
